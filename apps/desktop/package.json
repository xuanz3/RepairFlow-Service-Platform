{
  "name": "@repairflow/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "vite build && tsc -p electron/tsconfig.json",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "package:prepare": "node ../../tools/release/prepare-desktop-package.mjs",
    "package:mac": "pnpm package:prepare && electron-builder --projectDir .release-package --mac zip --arm64",
    "package:win": "pnpm package:prepare && electron-builder --projectDir .release-package --win portable --x64",
    "package:linux": "pnpm package:prepare && electron-builder --projectDir .release-package --linux AppImage --x64",
    "a11y": "playwright test --config=playwright.a11y.config.ts"
  },
  "dependencies": {
    "@repairflow/api-client": "workspace:*",
    "@repairflow/contracts": "workspace:*",
    "@repairflow/design-tokens": "workspace:*",
    "motion": "12.43.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@repairflow/sync-engine": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.2",
    "@types/react": "~19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "vite": "8.2.0",
    "wait-on": "9.1.0",
    "electron-builder": "26.15.3",
    "@axe-core/playwright": "4.12.1"
  }
}
