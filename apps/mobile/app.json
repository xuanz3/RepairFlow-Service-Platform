{
  "expo": {
    "name": "RepairFlow",
    "slug": "repairflow-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "repairflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RepairFlow to capture repair evidence and scan device labels.",
          "barcodeScannerEnabled": true,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xuanz3.repairflow.mobile"
    },
    "android": {
      "package": "com.xuanz3.repairflow.mobile"
    }
  }
}
