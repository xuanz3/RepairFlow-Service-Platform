{
  "name": "repairflow-service-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "e2e:desktop": "npm --prefix apps/desktop run e2e",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate:frameworks": "python3 scripts/validate_framework_gates.py",
    "validate:maestro": "python3 scripts/validate_maestro_flows.py",
    "validate:phase1": "python3 scripts/validate_phase1.py",
    "validate:phase2": "python3 scripts/validate_phase2.py",
    "validate:phase3": "python3 scripts/validate_phase3.py",
    "validate:phase3-security": "python3 scripts/validate_phase3_security.py",
    "validate:repo": "python3 scripts/validate_repository.py",
    "test:failure": "node tools/verify/phase3-failure-scenarios.mjs",
    "measure:sync": "node tools/verify/measure-sync-engine.mjs",
    "verify": "python3 scripts/validate_repository.py && python3 scripts/validate_phase1.py && python3 scripts/validate_phase2.py && python3 scripts/validate_phase3.py && python3 scripts/validate_phase3_security.py && python3 scripts/validate_framework_gates.py && python3 scripts/validate_maestro_flows.py && prettier --check . && eslint . && turbo run typecheck && turbo run test && turbo run build",
    "verify:phase2": "npm run verify && npm run e2e:desktop",
    "verify:phase3": "npm run verify && npm run test:failure && npm run measure:sync",
    "release:metadata": "node tools/release/build-metadata.mjs",
    "release:checksums": "node tools/release/generate-checksums.mjs",
    "release:sbom": "node tools/release/generate-sbom.mjs",
    "release:verify": "node tools/verify/release-bundle-contract.mjs",
    "media:compose": "node tools/media/compose-final-media.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "eslint": "9.39.2",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "3.2.4",
    "sharp": "0.35.3"
  }
}
